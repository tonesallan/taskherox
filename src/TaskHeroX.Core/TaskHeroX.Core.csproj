<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>TaskHeroX.Core</AssemblyName>
    <RootNamespace>TaskHeroX.Core</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Iced" Version="1.21.0" />
  </ItemGroup>

  <!-- Cache de offsets por build (o que o engine Python resolveu) EMBUTIDO no assembly -> 1 exe de verdade.
       O Engine.Attach carrega offsets_<hash>.json embutido quando o build não está no KnownBuilds. -->
  <ItemGroup>
    <EmbeddedResource Include="Offsets\*.json" />
    <EmbeddedResource Include="Data\item_prices.json" />
    <EmbeddedResource Include="..\..\python_old_project\tools\Il2CppDumper\Il2CppDumper.exe"
                      LogicalName="TaskHeroX.Core.Tools.Il2CppDumper.exe" />
    <EmbeddedResource Include="..\..\python_old_project\tools\Il2CppDumper\config.json"
                      LogicalName="TaskHeroX.Core.Tools.Il2CppDumper.config.json" />
  </ItemGroup>

</Project>
